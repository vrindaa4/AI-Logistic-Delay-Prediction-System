{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Angular: Start Dev Server",
      "type": "shell",
      "command": "cd frontend && npm start",
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Angular: Build Production",
      "type": "shell",
      "command": "cd frontend && npm run build",
      "group": "build"
    },
    {
      "label": "Angular: Run Tests",
      "type": "shell",
      "command": "cd frontend && npm test",
      "group": "test"
    },
    {
      "label": "Angular: Watch Build",
      "type": "shell",
      "command": "cd frontend && npm run watch",
      "isBackground": true,
      "group": "build"
    },
    {
      "label": "Frontend: Install Dependencies",
      "type": "shell",
      "command": "cd frontend && npm install",
      "group": "build"
    }
  ]
}
